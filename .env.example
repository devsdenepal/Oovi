# Copy to .env and fill in your own values.
# Every model in this project is open-weight and runs on-device through the
# server-side provider below; the browser only ever calls /api/ai.

# On-device provider (Ollama, no key). Serves the local Gemma model.
# Install from https://ollama.com, then pull the model:
#   ollama pull gemma4:e2b
#   OLLAMA_URL=http://127.0.0.1:11434
#   OLLAMA_MODEL=gemma4:e2b
#   AI_CHAIN=ollama
#
# The browser sends one normalized POST /api/ai; api/_aiChain.js routes it to
# Ollama. No AI key ever reaches the browser, and there is no client-side
# provider switch.

# Pollinations image assets (icons/logos). Server-side only via
# api/asset.js: set POLLINATIONS_KEY (never VITE_-prefixed) in .env for
# `vercel dev`, and in the Vercel project dashboard for production.
# The browser NEVER holds a key. Local `npm run dev` (no functions
# runner) falls back to keyless direct calls.
# Image model for generated assets (turbo = fast drafts, flux = quality).
# VITE_POLLINATIONS_MODEL=turbo

# Unsplash photo search (Insert panel). Access key is public-by-design
# and rate-limited; the secret key is never stored (OAuth unused).
# VITE_UNSPLASH_ACCESS_KEY=your-access-key

# Local Postgres (server-only, never VITE_-prefixed).
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your-password
# PGDATABASE=oovi

# Offline/cost-free UI work (no network calls at all).
# VITE_MOCK_AI=1

# Copy to .env and fill in your own values.
# The demo ships configured for the AI Conductor endpoint on Vercel.

VITE_AICONDUCTOR_URL=https://aiconductor.vercel.app
VITE_AICONDUCTOR_TOKEN=your-token-here
# Optional: only set if your provider requires it (AI Conductor rejects model).
# VITE_AICONDUCTOR_MODEL=aiconductor
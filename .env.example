# Copy to .env and fill in your own values.
# Every model in this project is open-weight and reached through the
# server-side chain below; the browser only ever calls /api/groq.

# Groq (open-weight gpt-oss-120b; key server-side, never in the browser).
# VITE_GROQ_MODEL=openai/gpt-oss-120b  (alt: openai/gpt-oss-20b)
# GROQ_API_KEY lives in your LOCAL .env only (gitignored). Put the real
# key there; this file keeps a placeholder. Rotate the key if it leaks.

# Server-side AI chain (api/_aiChain.js). Every /api/groq request walks
# these providers in order and returns the first success, so a rate limit
# or outage on one never drops a component. All keys are server-only.
#   GROQ_API_KEY=<your-groq-key>            (rung 1)
#   GEMINI_API_KEY=<your-gemini-key>        (rung 2 — separate quota pool)
#   GEMINI_MODEL=gemma-4-31b-it  (alt: gemma-4-26b-a4b-it answers under
#   load but ignores JSON discipline — prose, not parseable objects)
#   OPENROUTER_API_KEY=<your-openrouter-key> (rung 3 — OpenAI-compatible)
#   OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#   OLLAMA_URL=http://127.0.0.1:11434   (rung 4 — on-device, no key)
#   OLLAMA_MODEL=gpt-oss:20b            (open-weight, fits 16GB RAM)
#   AI_CHAIN=groq,gemini,openrouter,ollama
#
# Every rung runs an OPEN-WEIGHT model. Ollama is optional: install from
# https://ollama.com and `ollama pull gpt-oss:20b`; when it is not running
# the rung falls through instantly. Put "ollama" first in AI_CHAIN to make
# on-device the primary provider.

# Pollinations image assets (icons/logos). Server-side only via
# api/asset.js: set POLLINATIONS_KEY (never VITE_-prefixed) in .env for
# `vercel dev`, and in the Vercel project dashboard for production.
# The browser NEVER holds a key. Local `npm run dev` (no functions
# runner) falls back to keyless direct calls.
# Image model for generated assets (turbo = fast drafts, flux = quality).
# VITE_POLLINATIONS_MODEL=turbo

# Unsplash photo search (Insert panel). Access key is public-by-design
# and rate-limited; the secret key is never stored (OAuth unused).
# VITE_UNSPLASH_ACCESS_KEY=your-access-key

# Offline/cost-free UI work (no network calls at all).
# VITE_MOCK_AI=1
# Copy to .env and fill in your own values.
# Text-generation models in this project are open-weight and run on-device
# through the server-side provider below; the browser only ever calls /api/ai.
# Optional reference analysis (OCR and background removal) runs locally in
# the browser.

# On-device provider (Ollama, no key). Serves the local Gemma model.
# Install from https://ollama.com, then pull the model:
#   ollama pull gemma4:e2b
#   OLLAMA_URL=http://127.0.0.1:11434
#   OLLAMA_MODEL=gemma4:e2b
#   AI_CHAIN=ollama
#
# Per-layer model override (optional). When set, each layer call uses its own
# model name instead of the default. This lets a brief, cheap model handle the
# narrow layers while the main model handles the heavy lift. Leave blank to
# fall back to OLLAMA_MODEL for every call.
#   OLLAMA_MODEL_TUNE=gemma3:1b       # template choice + tuning patch
#   OLLAMA_MODEL_COPY_DECK=gemma4:e2b # whole-design copy deck (one call)
#   OLLAMA_MODEL_COPY=gemma3:270m     # slot layout/copy fallback (one-shots)
#   OLLAMA_MODEL_FALLBACK=gemma3:1b   # goal + palette
#   OLLAMA_NUM_CTX=4096
#   OLLAMA_NUM_PREDICT=600
#
# The 270m and 1B models are fast but echo region metadata or ignore strict
# character/repetition budgets in the copy-deck call. Keep the copy deck on a
# model that follows the JSON schema and hard limits; goal/palette and the
# narrower per-region calls can stay on the smaller model. The 10-minute path
# assumes goal/palette on 1B, the copy deck on gemma4:e2b, and one or two copy
# repairs rather than a full regeneration loop.
#
# The browser sends one normalized POST /api/ai; api/_aiChain.js routes it to
# Ollama. No AI key ever reaches the browser, and there is no client-side
# provider switch.

# Unsplash photo search (AI image regions + Insert panel). Access key is
# public-by-design and rate-limited; the secret key is never stored (OAuth
# unused).
# VITE_UNSPLASH_ACCESS_KEY=your-access-key

# Local Postgres (server-only, never VITE_-prefixed).
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your-password
# PGDATABASE=oovi

# Offline/cost-free UI work (no network calls at all).
# VITE_MOCK_AI=1
